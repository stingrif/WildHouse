# ─── NestJS API ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# PostgreSQL (Cloud SQL local proxy или Docker)
DATABASE_URL=postgresql://wildhouse:password@localhost:5432/wildhouse_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-256bit-random-string

# Firebase
FIREBASE_PROJECT_ID=wildhouse-app
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Google Cloud Storage
GCS_BUCKET_NAME=wildhouse-media
GCS_PROJECT_ID=wildhouse-app

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TRANZILA_TERMINAL=your-terminal
TRANZILA_KEY=your-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://admin.wildhouse.app
